# ---------------------------------------------------------------------------
# Jira Planner — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is committed.
#
#   cp .env.example .env
#
# !! READ THIS BEFORE ADDING ANY SECRET !!
#
# This app is a BROWSER-ONLY app with no backend. Vite INLINES every
# `VITE_`-prefixed variable into the public JavaScript bundle as plain text.
# Anyone who loads the page can read them (View Source / DevTools).
#
#   VITE_*  -> shipped to the browser.  NON-SECRET VALUES ONLY.
#   others  -> readable only by the Node build/dev process (vite.config.js).
#
# API tokens therefore do NOT belong in this file. Jira and Confluence tokens
# are entered in the app's Settings panel and stored AES-GCM encrypted in
# localStorage (src/utils/storage.js). See README "Credentials".
# ---------------------------------------------------------------------------


# --- Build/dev-process only (NOT exposed to the browser) -------------------

# Atlassian site used as the proxy target for /rest, /agile, /wiki.
# Site name only — no https://, no trailing slash.
VITE_JIRA_DOMAIN=tenderboard.atlassian.net

# Route Jira calls through a same-origin proxy instead of calling Atlassian
# directly. REQUIRED in any deployment that is not localhost: Atlassian Cloud
# sends no CORS headers for arbitrary origins, so a direct browser call from
# your host is blocked. See deploy/nginx.conf and RELEASING.md.
#   unset -> proxy on localhost only (the dev server proxies)
#   true  -> always proxy (build this way for production)
VITE_USE_PROXY=

# Where the Atlassian credential lives.
#   browser (default) — the user types an API token; it is kept in
#                       localStorage. Obfuscated, not encrypted: the key is
#                       derived from non-secret values. Fine locally; weak for
#                       a public deployment.
#   proxy             — the browser holds NO token. The reverse proxy attaches
#                       the Authorization header (deploy/nginx.conf), so a
#                       credential never reaches the page.
#
# proxy REQUIRES VITE_USE_PROXY=true and VITE_JIRA_DOMAIN, and the proxy MUST
# sit behind your own authentication — anyone who can reach it reads Jira.
VITE_AUTH_MODE=browser


# --- Public client config (exposed in the bundle — non-secret only) --------

# Jira board IDs. Numeric agile board IDs, read off the board URL:
#   .../jira/software/projects/XXX/boards/<ID>
# VITE_PRODUCT_BOARD_ID is only used for the "open the board in Jira" link --
# which cards belong to the Product Board is decided by VITE_PRODUCT_PROJECT_KEY.
VITE_PRODUCT_BOARD_ID=
VITE_ENG_BOARD_ID=

# Project keys for the dual-board system. These decide which project's issues
# form the Product Board, and which project an "Engineering card" must live in.
# Defaults are the verified live values, so these are optional.
VITE_PRODUCT_PROJECT_KEY=PDT
VITE_ENG_PROJECT_KEY=TSM2

# Confluence space for the "Create Documentation" button. Leave EMPTY to pick the
# space in Confluence each time (the current setup). Set a key to pin it, e.g.
#   TKS  TenderBoard Knowledge Base
#   TDS  TenderBoard Design Specifications
VITE_CONFLUENCE_SPACE_KEY=

# Jira custom field ID backing the "User Persona" field on product issues,
# e.g. customfield_10050. Find it at:
#   /rest/api/3/field  (search the JSON for your field's name)
VITE_USER_PERSONA_FIELD=

# Product project identifiers, used to build the prefilled Jira "create issue"
# link a human clicks (the app never creates issues itself — read-only rule).
# The numeric project id is resolved from the key via the local projects cache;
# set VITE_PRODUCT_PROJECT_ID only to override that lookup.
# Defaults below are the real Product Development Team project, so these are
# optional unless you point the app at a different project.
VITE_PRODUCT_PROJECT_ID=10085
# Default issue type for a new product card. PDT offers:
#   10267 Customer Request  (feature from a customer request - most common)
#   10268 Product Expansion (feature from an internal idea)
#   10370 Simple Change     (simple product update)
VITE_PRODUCT_ISSUE_TYPE_ID=10267

# Optional: custom field on the PRODUCT issue whose value is the Engineering
# issue key (e.g. a "Delivery Ticket" field containing "ENG-42"). When set, it
# is the highest-priority signal for matching a Product card to an Eng card,
# ahead of issue links and epic parentage.
VITE_ENG_LINK_FIELD=

# Customer Testing Board — the source of the Customer Dashboard. Customer cards
# are issues of type "Customer" in the engineering project; the board id is used
# for the "open board in Jira" link.
#   https://tenderboard.atlassian.net/jira/software/c/projects/TSM2/boards/22
VITE_CUSTOMER_BOARD_ID=22
VITE_CUSTOMER_ISSUE_TYPE=Customer

# Story Points custom field. Verified as customfield_10014 on this instance —
# the usual customfield_10016 / _10026 defaults do NOT exist here. Set in
# src/jira-config.js (CUSTOM_FIELDS.storyPoints) if you move instances.


# --- Credentials: DO NOT PUT THESE HERE ------------------------------------
#
# CONFLUENCE_API_TOKEN and the Jira API token are intentionally absent.
# There is no server process that could read them, and prefixing them with
# VITE_ would publish them to every visitor.
#
# Enter them in the app: Settings -> Connect. Both Jira and Confluence accept
# the same Atlassian API token, created at:
#   https://id.atlassian.com/manage/api-tokens
#
# If you later decide these must live in env, that requires adding a real
# server-side component to hold them. See README "Credentials".
